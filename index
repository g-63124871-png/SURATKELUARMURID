const students = studentRaw.trim().split('\n').map(line=>{
  const [ic, nama, kelas] = line.split('\t');
  return {ic: ic.trim(), nama: nama.trim(), kelas: kelas.trim()};
});

// unique kelas list, sorted by grade number then name
const kelasList = [...new Set(students.map(s=>s.kelas))].sort((a,b)=>{
  const na = parseInt(a,10), nb = parseInt(b,10);
  if(na !== nb) return na - nb;
  return a.localeCompare(b);
});

function initKelasDropdowns(){
  ['k_kelas'].forEach(id=>{
    const sel = document.getElementById(id);
    kelasList.forEach(k=>{
      const opt = document.createElement('option');
      opt.value = k;
      opt.textContent = k;
      sel.appendChild(opt);
    });
  });
}

function populateStudents(prefix){
  const kelas = document.getElementById(prefix+'_kelas').value;
  const muridSel = document.getElementById(prefix+'_muridSelect');
  muridSel.innerHTML = '';
  if(!kelas){
    muridSel.innerHTML = '<option value="">— Pilih Kelas Dahulu —</option>';
    namaStore[prefix] = '';
    document.getElementById(prefix+'_tahun').value = '';
    document.getElementById(prefix+'_ic').value = '';
    updatePreview();
    return;
  }
  muridSel.innerHTML = '<option value="">— Pilih Nama Murid —</option>';
  students.filter(s=>s.kelas===kelas).sort((a,b)=>a.nama.localeCompare(b.nama)).forEach(s=>{
    const opt = document.createElement('option');
    opt.value = s.ic;
    opt.textContent = s.nama.toUpperCase();
    muridSel.appendChild(opt);
  });
  document.getElementById(prefix+'_tahun').value = '';
  document.getElementById(prefix+'_ic').value = '';
  updatePreview();
}

function fillStudent(prefix){
  const ic = document.getElementById(prefix+'_muridSelect').value;
  const kelas = document.getElementById(prefix+'_kelas').value;
  const student = students.find(s=>s.ic===ic);
  if(student){
    document.getElementById(prefix+'_tahun').value = student.kelas;
    document.getElementById(prefix+'_ic').value = student.ic;
    namaStore[prefix] = student.nama.toUpperCase();
  } else {
    document.getElementById(prefix+'_tahun').value = '';
    document.getElementById(prefix+'_ic').value = '';
    namaStore[prefix] = '';
  }
  updatePreview();
}

const namaStore = {k:''};

const officers = [
  {nama: 'EN ABDUL RAHIM BIN ABDULLAH', jawatan: 'GURU BESAR'},
  {nama: 'EN MOHD RIZAL BIN SARITI', jawatan: 'PENOLONG KANAN PENTADBIRAN'},
  {nama: 'EN SALAHUDDIN BIN MOHD SALLEH', jawatan: 'PENOLONG KANAN HAL EHWAL MURID'},
  {nama: 'EN AHMED HISYAM BIN JUSOH', jawatan: 'PENOLONG KANAN KOKURIKULUM'}
];

function initOfficerDropdowns(){
  ['k_pegawai'].forEach(id=>{
    const sel = document.getElementById(id);
    officers.forEach((o, i)=>{
      const opt = document.createElement('option');
      opt.value = i;
      opt.textContent = o.nama + ' — ' + o.jawatan;
      sel.appendChild(opt);
    });
  });
}

function fmtDate(val){
  if(!val) return '';
  const [y,m,d] = val.split('-');
  const bulan = ['Januari','Februari','Mac','April','Mei','Jun','Julai','Ogos','September','Oktober','November','Disember'];
  return `${d} ${bulan[parseInt(m,10)-1]} ${y}`;
}
function fmtTime(val){
  if(!val) return '';
  return val;
}
function setText(id, val, placeholder){
  const el = document.getElementById(id);
  el.textContent = val && val.trim() !== '' ? val : (placeholder ? '' : '\u00A0');
}

function updatePreview(){
  setText('p_rujukan', document.getElementById('rujukan').value);
  setText('p_tarikh', fmtDate(document.getElementById('tarikh').value));

  // keluar
  setText('p_k_nama', namaStore.k);
  setText('p_k_tahun', document.getElementById('k_tahun').value);
  setText('p_k_ic', document.getElementById('k_ic').value);
  setText('p_k_masa', fmtTime(document.getElementById('k_masa').value));
  setText('p_k_sebab', document.getElementById('k_sebab').value);
  setText('p_k_penjaga', document.getElementById('k_penjaga').value);
  setText('p_k_hubungan', document.getElementById('k_hubungan').value);
  setText('p_k_tel', document.getElementById('k_tel').value);
  const kOfficerIdx = document.getElementById('k_pegawai').value;
  if(kOfficerIdx !== ''){
    const o = officers[kOfficerIdx];
    setText('p_k_guru', o.nama);
    document.getElementById('p_k_jawatan').innerHTML = o.jawatan + '<br>Sekolah Kebangsaan Sepri Tengah';
  } else {
    setText('p_k_guru', '');
    document.getElementById('p_k_jawatan').innerHTML = '&nbsp;<br>Sekolah Kebangsaan Sepri Tengah';
  }
}

document.querySelectorAll('input, textarea').forEach(el=>{
  el.addEventListener('input', updatePreview);
});

// default date = today
const today = new Date().toISOString().split('T')[0];
document.getElementById('tarikh').value = today;
initKelasDropdowns();
initOfficerDropdowns();
updatePreview();
